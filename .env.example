# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth providers. Each one appears on the sign-in page only when its ID is set.
# Leave both unset locally to use the one-click "dev" sign-in instead.

# GitHub OAuth app (https://github.com/settings/developers).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client (https://console.cloud.google.com/auth/clients), type "Web application".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres, added automatically by the Vercel Marketplace integration.
# Leave unset locally to use an embedded PGlite database in ./.pglite
DATABASE_URL=
